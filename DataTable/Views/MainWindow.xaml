<Window x:Class="EngineAnalyzer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="\Resources\app.ico"
        xmlns:controls="clr-namespace:EngineAnalyzer.Views.Controls"
        xmlns:matrix="clr-namespace:EngineAnalyzer.Views.Matrix"
        xmlns:plot="clr-namespace:EngineAnalyzer.Views.Plot"
        Title="DataTable V.0"
        Height="950"
        Width="1650"
        MinHeight="700"
        MinWidth="1100"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <controls:ControlPanelView x:Name="ControlPanel"
                                   Grid.Row="0"/>

        <TabControl Grid.Row="1">
            <TabItem Header="3D-график">
                <plot:SurfacePlotView x:Name="SurfacePlot"/>
            </TabItem>

            <TabItem Header="Матрица COV">
                <matrix:CovMatrixView x:Name="MatrixView"/>
            </TabItem>
        </TabControl>

        <controls:StatusPanelView x:Name="StatusPanel"
                                  Grid.Row="2"/>
    </Grid>
</Window>
