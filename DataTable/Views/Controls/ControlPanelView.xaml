<UserControl x:Class="EngineAnalyzer.Views.Controls.ControlPanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Margin="0,0,0,8" Padding="8" BorderBrush="Gray" BorderThickness="1"
            CornerRadius="5">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <!-- Источники -->
            <StackPanel Grid.Row="0" Margin="0,0,0,8" Orientation="Horizontal">
                <Button x:Name="OpenCsvButton" Width="150" Height="32" Margin="0,0,8,0"
                        x:FieldModifier="public" Content="Открыть CSV-файлы" />
                <Button x:Name="PostgresButton" Width="130" Height="32" Margin="0,0,8,0"
                        x:FieldModifier="public" Content="Из PostgreSQL" />
                <Button x:Name="TestPostgresButton" Width="165" Height="32" Margin="0,0,8,0"
                        x:FieldModifier="public" Content="Проверить PostgreSQL" />
                <Button x:Name="ResetViewButton" Width="110" Height="32" Margin="0,0,8,0"
                        x:FieldModifier="public" Content="Сбросить вид" />
                <Button x:Name="UpdateButton" Width="110" Height="32" Margin="0,0,8,0"
                        x:FieldModifier="public" Content="Обновить"
                        ToolTip="Применить параметры; при смене сигналов перечитать последний источник" />
                <Button x:Name="PrintTableButton" Width="165" Height="32" Margin="0,0,8,0"
                        x:FieldModifier="public" Content="Печать таблицы / PDF" />
                <Button x:Name="PrintGraphButton" Width="165" Height="32" Margin="0,0,8,0"
                        x:FieldModifier="public" Content="Печать графика / PDF" />
                <Button x:Name="ExportExcelButton" Width="150" Height="32" x:FieldModifier="public"
                        Content="Выгрузить в Excel" />
            </StackPanel>
            <GroupBox Grid.Row="1" Margin="0,0,0,8" Padding="5" Header="Сигналы и названия осей">
                <WrapPanel>
                    <TextBlock VerticalAlignment="Center" Text="CSV Date:" />
                    <ComboBox x:Name="CsvDateColumnComboBox" Width="110" Margin="3" x:FieldModifier="public"
                              IsEditable="True" Text="Date" />
                    <TextBlock VerticalAlignment="Center" Text="Ось X:" />
                    <ComboBox x:Name="CsvXColumnComboBox" Width="130" Margin="3" x:FieldModifier="public"
                              IsEditable="True" Text="IntTempOut" />
                    <TextBlock VerticalAlignment="Center" Text="Ось Y:" />
                    <ComboBox x:Name="CsvYColumnComboBox" Width="115" Margin="3" x:FieldModifier="public"
                              IsEditable="True" Text="Power" />
                    <TextBlock VerticalAlignment="Center" Text="RPM / отклонение:" />
                    <ComboBox x:Name="CsvMetricColumnComboBox" Width="145" Margin="3" x:FieldModifier="public"
                              IsEditable="True" Text="Engine Speed" />
                    <CheckBox x:Name="CsvMetricIsDeviationCheckBox" Margin="5,0,12,0" VerticalAlignment="Center" x:FieldModifier="public"
                              Content="готовое отклонение" />
                    <TextBlock VerticalAlignment="Center" Text="Название X:" />
                    <TextBox x:Name="XAxisTitleTextBox" Width="125" Margin="3" x:FieldModifier="public"
                             Text="IntTempOut, °C" />
                    <TextBlock VerticalAlignment="Center" Text="Название Y:" />
                    <TextBox x:Name="YAxisTitleTextBox" Width="110" Margin="3,3,12,3" x:FieldModifier="public"
                             Text="Power, kW" />
                    <TextBlock VerticalAlignment="Center" Text="PostgreSQL ID X:" />
                    <TextBox x:Name="PgXTagIdTextBox" Width="50" Margin="3" x:FieldModifier="public"
                             Text="569" />
                    <TextBlock VerticalAlignment="Center" Text="ID Y:" />
                    <TextBox x:Name="PgYTagIdTextBox" Width="50" Margin="3" x:FieldModifier="public"
                             Text="558" />
                    <TextBlock VerticalAlignment="Center" Text="ID RPM/откл.:" />
                    <TextBox x:Name="PgSpeedTagIdTextBox" Width="50" Margin="3" x:FieldModifier="public"
                             Text="625" />
                    <CheckBox x:Name="PgMetricIsDeviationCheckBox" Margin="5,0,0,0" VerticalAlignment="Center" x:FieldModifier="public"
                              Content="ID содержит готовое отклонение" />
                </WrapPanel>
            </GroupBox>
            <!-- Параметры -->
            <WrapPanel Grid.Row="2">
                <GroupBox Margin="0,0,10,0" Padding="5" Header="График: диапазон и шаг">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock VerticalAlignment="Center" Text="X min:" />
                        <TextBox x:Name="GraphTempMinTextBox" Width="45" Margin="3" x:FieldModifier="public"
                                 Text="0" />
                        <TextBlock VerticalAlignment="Center" Text="X max:" />
                        <TextBox x:Name="GraphTempMaxTextBox" Width="45" Margin="3" x:FieldModifier="public"
                                 Text="100" />
                        <TextBlock VerticalAlignment="Center" Text="Шаг X:" />
                        <TextBox x:Name="GraphTempStepTextBox" Width="45" Margin="3,3,10,3" x:FieldModifier="public"
                                 Text="1" />
                        <TextBlock VerticalAlignment="Center" Text="Y min:" />
                        <TextBox x:Name="GraphPowerMinTextBox" Width="55" Margin="3" x:FieldModifier="public"
                                 Text="0" />
                        <TextBlock VerticalAlignment="Center" Text="Y max:" />
                        <TextBox x:Name="GraphPowerMaxTextBox" Width="55" Margin="3" x:FieldModifier="public"
                                 Text="1000" />
                        <TextBlock VerticalAlignment="Center" Text="Шаг Y:" />
                        <TextBox x:Name="GraphPowerStepTextBox" Width="50" Margin="3" x:FieldModifier="public"
                                 Text="10" />
                    </StackPanel>
                </GroupBox>
                <GroupBox Margin="0,0,10,0" Padding="5" Header="Таблица: диапазон и шаг">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock VerticalAlignment="Center" Text="X min:" />
                        <TextBox x:Name="TableTempMinTextBox" Width="45" Margin="3" x:FieldModifier="public"
                                 Text="0" />
                        <TextBlock VerticalAlignment="Center" Text="X max:" />
                        <TextBox x:Name="TableTempMaxTextBox" Width="45" Margin="3" x:FieldModifier="public"
                                 Text="100" />
                        <TextBlock VerticalAlignment="Center" Text="Шаг X:" />
                        <TextBox x:Name="TableTempStepTextBox" Width="45" Margin="3,3,10,3" x:FieldModifier="public"
                                 Text="1" />
                        <TextBlock VerticalAlignment="Center" Text="Y min:" />
                        <TextBox x:Name="TablePowerMinTextBox" Width="55" Margin="3" x:FieldModifier="public"
                                 Text="0" />
                        <TextBlock VerticalAlignment="Center" Text="Y max:" />
                        <TextBox x:Name="TablePowerMaxTextBox" Width="55" Margin="3" x:FieldModifier="public"
                                 Text="1000" />
                        <TextBlock VerticalAlignment="Center" Text="Шаг Y:" />
                        <TextBox x:Name="TablePowerStepTextBox" Width="50" Margin="3" x:FieldModifier="public"
                                 Text="10" />
                    </StackPanel>
                </GroupBox>
                <!-- Анализ -->
                <GroupBox Margin="0,0,10,0" Padding="5" Header="Анализ">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock VerticalAlignment="Center" Text="Номинал RPM:" />
                        <TextBox x:Name="NominalRpmTextBox" Width="60" Margin="4" x:FieldModifier="public"
                                 Text="1500" />
                        <TextBlock VerticalAlignment="Center" Text="Max отклонение RPM:" />
                        <TextBox x:Name="MaxDeviationTextBox" Width="60" Margin="4" x:FieldModifier="public"
                                 Text="1000" />
                    </StackPanel>
                </GroupBox>
                <!-- PostgreSQL -->
                <GroupBox Padding="5" Header="PostgreSQL">
                    <WrapPanel>
                        <TextBlock VerticalAlignment="Center" Text="Host:" />
                        <TextBox x:Name="PgHostTextBox" Width="100" Margin="3" x:FieldModifier="public"
                                 Text="localhost" />
                        <TextBlock VerticalAlignment="Center" Text="Port:" />
                        <TextBox x:Name="PgPortTextBox" Width="50" Margin="3" x:FieldModifier="public"
                                 Text="5432" />
                        <TextBlock VerticalAlignment="Center" Text="DB:" />
                        <TextBox x:Name="PgDatabaseTextBox" Width="90" Margin="3" x:FieldModifier="public" />
                        <TextBlock VerticalAlignment="Center" Text="User:" />
                        <TextBox x:Name="PgUserTextBox" Width="80" Margin="3" x:FieldModifier="public" />
                        <TextBlock VerticalAlignment="Center" Text="Password:" />
                        <PasswordBox x:Name="PgPasswordBox" Width="90" Margin="3" x:FieldModifier="public" />
                        <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Text="От:" />
                        <TextBox x:Name="PgFromTextBox" Width="145" Margin="3" x:FieldModifier="public"
                                 Text="2026-07-23 00:00:00" />
                        <TextBlock VerticalAlignment="Center" Text="До (не включая):" />
                        <TextBox x:Name="PgToTextBox" Width="145" Margin="3" x:FieldModifier="public"
                                 Text="2026-07-25 23:59:59" />
                    </WrapPanel>
                </GroupBox>
            </WrapPanel>
        </Grid>
    </Border>
</UserControl>
